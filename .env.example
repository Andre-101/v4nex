DATABASE_URL=postgresql+psycopg://v4nex:devpassword@db:5432/v4nex

# Caddy
CADDY_PORT=8080
CADDY_ADMIN_URL=http://caddy:2019
CADDY_ADMIN_TIMEOUT_SECONDS=3

