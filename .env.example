RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_STRICT_MAX_REQUESTS=10

# Frontend
FRONTEND_PORT=5173

# Database
