# Backend
APP_ENV=development
BACKEND_PORT=8000
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PUBLIC_DOMAIN=v4nex.com
