# Production example only. Review before using in any real environment.
# Caddy Admin API must stay private to the Docker network because compose must not publish 2019.
{
  email {$CADDY_ACME_EMAIL}
  admin 0.0.0.0:2019
}

# Platform lives at the apex domain, for example v4nex.com.
# Customer services live under *.v4nex.com through dynamic routes loaded by the backend.
{$DOMAIN} {
  encode zstd gzip

  @api path /_v4nex/* /health
  handle @api {
    reverse_proxy backend:{$BACKEND_PORT}
  }

  handle {
    reverse_proxy frontend:80
  }
}

# Dynamic bridge routes are expected to be loaded through the Caddy Admin API by the backend.
# Future wildcard DNS-01 concept, not active in this example:
#
# *.{$CADDY_DOMAIN} {
#   tls {
#     dns cloudflare {env.CLOUDFLARE_API_TOKEN}
#   }
#   reverse_proxy [target_ipv6]:80
# }
#
# Caddy OSS needs a custom image with github.com/caddy-dns/cloudflare for the dns directive.
