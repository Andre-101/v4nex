FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM busybox:1.37.0-uclibc

COPY --from=builder /app/dist /www

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/ >/dev/null

CMD ["httpd", "-f", "-p", "80", "-h", "/www"]
