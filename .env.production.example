# Example only. Do not use these placeholder values in production.
# Copy to a protected environment file outside the repo and replace all change-me/example values.

APP_ENV=production
PUBLIC_DOMAIN=example.com
DATABASE_URL=postgresql+psycopg://v4nex:${POSTGRES_PASSWORD}@db:5432/v4nex
POSTGRES_DB=v4nex
POSTGRES_USER=v4nex
POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CADDY_ADMIN_URL=http://caddy:2019
CADDY_ADMIN_TIMEOUT_SECONDS=3
MAX_BRIDGES_PER_USER=5
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_STRICT_MAX_REQUESTS=10
ACME_EMAIL=admin@example.com
DNS_PROVIDER=cloudflare
DNS_PROVIDER_API_TOKEN=change-me
TLS_MODE=dns-01-wildcard
